{
  "name": "agent-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "tsx --test src/**/*.test.ts",
    "test:e2e": "node test/e2e/workspace-settings.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "nanoid": "^5.1.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
