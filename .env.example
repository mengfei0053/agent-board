# HTTP listen port (default 8791)
PORT=8791
# Bind address (default 127.0.0.1). Docker Compose sets 0.0.0.0
# HOST=0.0.0.0

# Postgres connection string
# - Local / host app. The postgres:postgres URL below is only a convenience for
#   a database you already created on this machine. It is not a Compose default
#   and it is not a strong password.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agent_board
# - Docker Compose: copy this file to .env and replace POSTGRES_PASSWORD with
#   a long random URL-safe value before `docker compose up`. The placeholder
#   is not a password and Compose will reject an empty one, but it will accept
#   the placeholder if you leave it — do not.
#   Compose publishes Postgres only on 127.0.0.1:5433.
#   Changing POSTGRES_PASSWORD does not rotate a password already stored in
#   the agent_board_pg volume; ALTER USER on that volume if it already exists.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=agent_board
# DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@127.0.0.1:5433/agent_board

# Optional: enable POST /api/hooks/tasks (and /webhook/tasks)
# AGENT_BOARD_WEBHOOK_SECRET=change-me
