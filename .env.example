# HTTP listen port (default 8791)
PORT=8791
# Bind address (default 127.0.0.1). Docker Compose sets 0.0.0.0
# HOST=0.0.0.0

# Postgres connection string
# - Local / host app (default matches ThinkBook postgres on :5432):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agent_board
# - Docker Compose app service uses the in-compose postgres automatically
#   (see docker-compose.yml). To point a host `pnpm dev` at compose Postgres:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/agent_board

# Optional: enable POST /api/hooks/tasks (and /webhook/tasks)
# AGENT_BOARD_WEBHOOK_SECRET=change-me
