# HTTP listen port (default 8791)
PORT=8791
# Bind address (default 127.0.0.1). Docker Compose sets 0.0.0.0
# HOST=0.0.0.0

# Database backend (local / host app)
# Unset, empty or whitespace-only DATABASE_URL selects SQLite at the resolved
# absolute path DATA_DIR/agent-board.db. DATA_DIR defaults to the repo data/.
# Existing PG users MUST keep their explicit URL to keep seeing their PG data.
# Switching URLs selects independent data: no dual writes, no automatic PG
# migration, and no fallback to SQLite when PG fails.
DATABASE_URL=
# Explicit SQLite URLs (relative paths are relative to process cwd, NOT DATA_DIR):
# DATABASE_URL=sqlite:./relative.db
# DATABASE_URL=sqlite:/absolute/path.db
# DATABASE_URL=sqlite::memory:
# Explicit postgres: and postgresql: URLs retain their existing behavior:
# DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5432/agent_board
# DATA_DIR=/absolute/path/to/data
# UPLOADS_DIR=/absolute/path/to/data/uploads
# UPLOADS_DIR defaults to DATA_DIR/uploads. DATA_DIR affects the default SQLite
# path, not explicit SQLite URLs. Legacy DATA_DIR/db.json imports into the
# currently selected backend once, then is renamed to db.json.migrated-*.
# SQLite: better-sqlite3 11.x (Node 20+), FK/WAL/5s busy_timeout, transactions
# serialized within one process. Recommended for a single local instance;
# never put the database on a network share. Stop the service before copying
# the file for backup. Online backups must handle WAL, not copy only the main DB.
# Business-layer memory caches mean PG does not guarantee multi-instance consistency.

# Docker Compose remains PG-only; it builds the app's PG URL from POSTGRES_*.
# Copy this file to .env and replace POSTGRES_PASSWORD with
#   a long random URL-safe value before `docker compose up`. The placeholder
#   is not a password and Compose will reject an empty one, but it will accept
#   the placeholder if you leave it — do not.
#   Compose publishes Postgres only on 127.0.0.1:5433.
#   Changing POSTGRES_PASSWORD does not rotate a password already stored in
#   the agent_board_pg volume; ALTER USER on that volume if it already exists.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=agent_board
# For a host app using Compose PG, explicitly export the URL (port 5433):
# DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@127.0.0.1:5433/agent_board

# Optional: enable POST /api/hooks/tasks (and /webhook/tasks)
# AGENT_BOARD_WEBHOOK_SECRET=change-me

# Optional embedded relay dialer. Default off. All three are required to dial.
# Do not commit real tokens. ThinkBook values live in Bitwarden `agent-board-relay 101`.
# Never run a standalone connector for the same BOARD_ID while this is enabled.
# RELAY_WS_URL=wss://relay.mengfei.tech/v1/ws
# BOARD_ID=
# BOARD_TOKEN=
# BOARD_LABEL=ThinkBook
# RELAY_RECONNECT_MIN_MS=500
# RELAY_RECONNECT_MAX_MS=15000
# RELAY_ENABLED=0
