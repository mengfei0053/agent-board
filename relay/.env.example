# Bind address. Keep loopback until TLS terminates in front of the process.
HOST=127.0.0.1
PORT=8787

# Required in production. When unset in local dev, the process generates them
# and prints them once. They are never written to disk.
# ADMIN_TOKEN=
# BOARD_TOKEN=

# Pair codes are created by POST /auth/pair/create. This is their maximum TTL.
# PAIR_TTL_MS=300000
# TOKEN_TTL_MS=604800000
# IDEMPOTENCY_TTL_MS=600000
# CMD_TIMEOUT_MS=8000
# PAIR_ATTEMPT_LIMIT=8
# PAIR_WINDOW_MS=60000
# WS_MESSAGES_PER_SEC=40
