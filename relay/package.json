{
  "name": "agent-board-relay",
  "version": "0.1.0",
  "private": true,
  "description": "In-memory relay between a phone and an agent-board connector.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "e2e": "tsx scripts/e2e.ts",
    "fake-board": "tsx scripts/fake-board.ts",
    "fake-phone": "tsx scripts/fake-phone.ts"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
